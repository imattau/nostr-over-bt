# Relay Configuration
PORT=8080
DOMAIN_NAME=relay.yourdomain.com
DB_PATH=./relay.db

# Storage backend: sqlite | polypack | unset (auto-detect)
# unset auto-selects @0xx0lostcause0xx0/polypack when the app already has it
# installed (a directory alongside DB_PATH is used for its data), otherwise
# falls back to sqlite. STORAGE_BACKEND=polypack forces it and errors if the
# package isn't installed.
STORAGE_BACKEND=

# Optional, polypack backend only: path/specifier to a module whose default
# (or "embedding") export is an EmbeddingProvider ({ dimensions?, embed(text) })
# used for NIP-50 search instead of polypack's built-in lexical hash embedding.
POLYPACK_EMBEDDING_MODULE=

# Private Mode (Optional)
# Comma-separated list of npubs or hex pubkeys allowed to publish
# If empty, the relay is public.
ALLOWED_PUBKEYS=npub1...,hex_pubkey...

# BitTorrent Configuration
ENABLE_BT=true
TRACKER_PORT=8081
DHT_PORT=6881
# Recommended: 1 per CPU core. For 2 cores, use 2.
SEEDING_CONCURRENCY=2

# Relay Information (NIP-11)
RELAY_NAME="My Nostr-BT Relay"
RELAY_DESCRIPTION="A decentralized relay backed by BitTorrent"
RELAY_PUBKEY="<your-hex-pubkey>"
RELAY_CONTACT="mailto:admin@example.com"
